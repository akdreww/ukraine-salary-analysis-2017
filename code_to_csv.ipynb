import json
import pandas as pd

file_path = r"C:\Users\User\Downloads\dataset_default_integration_sssu_df_salary_level_of_employees_latest.json"

with open(file_path, 'r', encoding='utf-8') as f:
    raw_data = json.load(f)


def get_title(item, default="Невідомо"):

    title = item.get('name', item.get('id', default))
    

    if isinstance(title, dict):
        return title.get('uk', title.get('en', str(title)))
        
    return title


structures = raw_data['data']['structures'][0] 
series_dims = structures['dimensions']['series']

obs_dims = structures['dimensions'].get('observation', []) 

series_data = raw_data['data']['dataSets'][0]['series']

flat_data = []


for series_key, series_info in series_data.items():
    dim_indices = series_key.split(':')
    row_base = {}
    

    for i, dim in enumerate(series_dims):
        dim_name = get_title(dim, f"Категорія_{i}")
        
        val_index = int(dim_indices[i])
        val_obj = dim['values'][val_index]
        val_name = get_title(val_obj, f"Значення_{val_index}")
        
        row_base[dim_name] = val_name
        
    observations = series_info.get('observations', {})
    for obs_key, obs_value in observations.items():
        row = row_base.copy()
        

        if obs_dims:
            time_dim = obs_dims[0]
            time_name = get_title(time_dim, "Час")
            
            time_val_index = int(obs_key)
            time_val_obj = time_dim['values'][time_val_index]
            time_val_name = get_title(time_val_obj, f"Період_{time_val_index}")
            
            row[time_name] = time_val_name
            

        row['Значення'] = float(obs_value[0]) if obs_value[0] is not None else None
        
        flat_data.append(row)


df_final = pd.DataFrame(flat_data)

display(df_final.head(10))


csv_path = file_path.replace('.json', '_Cleaned_Ready.csv')
df_final.to_csv(csv_path, encoding='utf-8-sig', index=False)

print(f"\nCSV файл збережено: {csv_path}")
